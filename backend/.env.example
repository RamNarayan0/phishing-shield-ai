# =====================================================================
# Phishing Shield AI — Environment Configuration Example
# Copy this file to .env and customize for your environment.
# Never commit real credentials, passwords, or production secrets to Git.
# =====================================================================

# MongoDB Database Configuration
# Local MongoDB on Windows (Default):
MONGODB_URI=mongodb://127.0.0.1:27017
# MongoDB Atlas (Alternative):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

MONGODB_DATABASE=phishing_shield_ai
MONGODB_COLLECTION=analysis_history

# Security & Limits
MAX_REQUEST_SIZE_BYTES=262144
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:5176,http://127.0.0.1:5176,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Optional Administrative Authentication
# Leave empty for local development demo mode, or set a strong key for production:
ADMIN_API_KEY=

# Server Configuration
PORT=8000
HOST=127.0.0.1
